# Docker Compose development only. Generate a unique password before startup.
WAREHOUSE_POSTGRES_PASSWORD=
WAREHOUSE_COOKIE_SECURE=false
# Optional: backend photo storage. Compose sets a dedicated persistent directory.
# WAREHOUSE_PHOTO_DIR=/absolute/warehouse-only/photo/directory
# Manual backend startup only (do not reuse CarPot DATABASE_URL):
# WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse:<url-encoded-password>@127.0.0.1:55433/warehouse_dev

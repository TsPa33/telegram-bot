{
  "description": "Dashboard checklist only; use the existing isolated warehouse-staging environment and postgres service in the EXISTING paid Railway project. Do not recreate or rename existing services. Never duplicate/sync production or change its resources.",
  "project": "<select-your-existing-Railway-project>",
  "environment": "warehouse-staging",
  "services": {
    "warehouse-web": {
      "source": {
        "repository": "TsPa33/telegram-bot",
        "branch": "feature/carpot-warehouse-mvp",
        "rootDirectory": "/warehouse"
      },
      "dockerfilePath": "deploy/railway/frontend.Dockerfile",
      "startCommand": "/usr/local/bin/warehouse-frontend",
      "healthcheckPath": "/health",
      "healthcheckTimeout": 180,
      "replicas": 1,
      "publicDomain": true,
      "targetPort": 8080,
      "watchPaths": [
        "/warehouse/frontend/**",
        "/warehouse/deploy/railway/frontend.Dockerfile",
        "/warehouse/deploy/railway/frontend-start.sh",
        "/warehouse/deploy/railway/nginx/**",
        "/warehouse/.dockerignore"
      ],
      "variables": {
        "PORT": "8080",
        "RAILWAY_DOCKERFILE_PATH": "deploy/railway/frontend.Dockerfile",
        "WAREHOUSE_PUBLIC_ORIGIN": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
        "WAREHOUSE_BACKEND_ORIGIN": "http://${{warehouse-api.RAILWAY_PRIVATE_DOMAIN}}:8010",
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": "30"
      }
    },
    "warehouse-api": {
      "source": {
        "repository": "TsPa33/telegram-bot",
        "branch": "feature/carpot-warehouse-mvp",
        "rootDirectory": "/warehouse"
      },
      "dockerfilePath": "deploy/railway/backend.Dockerfile",
      "startCommand": "python -m app.staging",
      "healthcheckPath": "/health",
      "healthcheckTimeout": 180,
      "replicas": 1,
      "publicDomain": false,
      "watchPaths": [
        "/warehouse/backend/**",
        "/warehouse/deploy/railway/backend.Dockerfile",
        "/warehouse/.dockerignore"
      ],
      "variables": {
        "PORT": "8010",
        "RAILWAY_DOCKERFILE_PATH": "deploy/railway/backend.Dockerfile",
        "WAREHOUSE_ENV": "staging",
        "WAREHOUSE_COOKIE_SECURE": "true",
        "WAREHOUSE_REGISTRATION_ENABLED": "false",
        "WAREHOUSE_PUBLIC_ORIGIN": "https://${{warehouse-web.RAILWAY_PUBLIC_DOMAIN}}",
        "WAREHOUSE_DB_HOST": "${{postgres.RAILWAY_PRIVATE_DOMAIN}}",
        "WAREHOUSE_DB_PORT": "5432",
        "WAREHOUSE_DB_NAME": "${{postgres.POSTGRES_DB}}",
        "WAREHOUSE_DB_USER": "${{postgres.POSTGRES_USER}}",
        "WAREHOUSE_DB_PASSWORD": "${{postgres.POSTGRES_PASSWORD}}",
        "WAREHOUSE_STARTUP_TIMEOUT": "120",
        "WAREHOUSE_FORWARDED_ALLOW_IPS": "fd00::/8,10.0.0.0/8",
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": "30"
      }
    },
    "postgres": {
      "image": "postgres:16-alpine",
      "publicDomain": false,
      "tcpProxy": false,
      "replicas": 1,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "POSTGRES_DB": "warehouse_staging",
        "POSTGRES_USER": "warehouse_staging",
        "POSTGRES_PASSWORD": "GENERATE_A_NEW_SECRET_IN_RAILWAY_SETTINGS",
        "PGDATA": "/var/lib/postgresql/data/pgdata",
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": "30"
      }
    }
  },
  "projectSelection": "EXISTING",
  "environmentCreation": "EMPTY",
  "productionChangesAllowed": false
}

# Target: NEW EMPTY warehouse-staging environment in the EXISTING Railway project.
# Railway environment name is warehouse-staging; application WAREHOUSE_ENV stays staging.
# Reference only. Set these in the TWO application services, not shared project variables.
# Never put CarPot DATABASE_URL or CarPot credentials in this environment.
# See services.json and RAILWAY_STAGING.md for Railway reference expressions.
WAREHOUSE_ENV=staging
WAREHOUSE_COOKIE_SECURE=true
WAREHOUSE_REGISTRATION_ENABLED=false
WAREHOUSE_PUBLIC_ORIGIN=https://<warehouse-web-generated-domain>.up.railway.app
# API only: copy references to the NEW, private Warehouse PostgreSQL service.
WAREHOUSE_DB_HOST=<warehouse-db-private-domain>.railway.internal
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse_staging
WAREHOUSE_DB_USER=warehouse_staging
WAREHOUSE_DB_PASSWORD=
WAREHOUSE_STARTUP_TIMEOUT=120
WAREHOUSE_FORWARDED_ALLOW_IPS=fd00::/8,10.0.0.0/8
# Optional API photos: requires a dedicated volume and documented UID bootstrap.
# WAREHOUSE_PHOTO_DIR=/data/photos
# RAILWAY_RUN_UID=0
# WEB only:
WAREHOUSE_BACKEND_ORIGIN=http://<warehouse-api-private-domain>.railway.internal:8010
# PORT=8010 on API; PORT=8080 on WEB.

# Warehouse service instances only: allow graceful shutdown between test sessions.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
